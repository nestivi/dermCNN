# This .env file contains configuration parameters for the DermCNN project, including paths to data, training hyperparameters, model architecture settings, and other options for controlling the training and evaluation process.

# Training hyperparameters
EPOCHS=30
BATCH_SIZE=32
LEARNING_RATE=0.0001
# OPTIMIZER=adam

# Model architecture settings
IMG_SIZE=224
DROPOUT_RATE=0.3          # How much dropout to apply in the fully connected layers
DENSE_UNITS=256           # Number of neurons in the last layer before classification

# Callbacks and training control
EARLY_STOPPING_PATIENCE=5
USE_DATA_AUGMENTATION=True
VALIDATION_SPLIT=0.2

# Environment control
RANDOM_SEED=42            # Always the same splits and results for reproducibility
DEBUG_MODE=False          # Debug mode can be used to cut the dataset to 100 images for quick testing
NUM_WORKERS=4